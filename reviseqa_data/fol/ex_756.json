                    "\u2200x (\u00acp_7(x) \u2192 \u00acp_\u6781\u901f\u8d5b\u8f66\u5f00\u5956\u76f4\u64ad\u5386\u53f2\u8bb0\u5f55(x))"
                ]
            }
        }
    ]
}